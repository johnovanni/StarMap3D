<Window x:Class="StarMap3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarMap3D"
        Title="Nearby stars"
        Width="1320" Height="860" MinWidth="900" MinHeight="600"
        Background="#0A0E17" Foreground="#DDE6F5" FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8F0FF"/>
            <Setter Property="Background" Value="#22324E"/>
            <Setter Property="BorderBrush" Value="#3A5077"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33507F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2740"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#E8F0FF"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Explicit bright foreground for every plain TextBlock in the side panel (slider captions
             included) so labels stay readable against the dark background no matter what the
             active Windows theme would otherwise supply. Any TextBlock below that sets its own
             Foreground still wins over this default. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8F0FF"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FB2FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <local:StarMapView x:Name="Map" Grid.Column="0"/>

        <!-- floating status line -->
        <Border Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10"
                Background="#AA0A0E17" CornerRadius="4" Padding="8,4" MaxWidth="820">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#AFC4E6" Text="Starting..."/>
        </Border>

        <Border Grid.Column="1" Background="#101726" BorderBrush="#25314A" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,10,14,14">

                    <TextBlock Text="Nearby stars" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="CountText" Foreground="#9FB4D8" Margin="0,2,0,0" TextWrapping="Wrap"/>

                    <TextBlock Style="{StaticResource Head}" Text="LEGEND"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Canvas Width="34" Height="22">
                            <Ellipse Canvas.Left="14" Canvas.Top="8" Width="6" Height="6" Fill="#FFD9A0"/>
                        </Canvas>
                        <TextBlock VerticalAlignment="Center" Text="Star (no known planets)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Canvas Width="34" Height="22">
                            <Ellipse Canvas.Left="14" Canvas.Top="8" Width="6" Height="6" Fill="#FFD9A0"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="4" Width="14" Height="14" Stroke="#5AE1FF" StrokeThickness="1.1"/>
                            <Ellipse Canvas.Left="6" Canvas.Top="0" Width="22" Height="22" Stroke="#5AE1FF" StrokeThickness="1.1"/>
                        </Canvas>
                        <TextBlock VerticalAlignment="Center" Text="Planet host: one ring per planet"/>
                    </StackPanel>
                    <TextBlock Foreground="#8CA0C4" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Dot colour = spectral type (blue O/B, white A/F, yellow G, orange K, red M). Dot size = brightness. Brighter = closer to you."/>

                    <TextBlock Style="{StaticResource Head}" Text="RANGE"/>
                    <DockPanel><TextBlock Text="Max distance" Width="100"/><TextBlock x:Name="DistanceText" HorizontalAlignment="Right" Foreground="#9FB4D8"/></DockPanel>
                    <Slider x:Name="SlDistance" ValueChanged="Distance_Changed"/>
                    <TextBlock Foreground="#8CA0C4" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="Catalogues are downloaded once, out to the maximum range below; moving the slider just re-filters what's already loaded."/>

                    <TextBlock Style="{StaticResource Head}" Text="ORIENTATION"/>
                    <DockPanel><TextBlock Text="Rotate (yaw)" Width="100"/><TextBlock x:Name="YawText" HorizontalAlignment="Right" Foreground="#9FB4D8"/></DockPanel>
                    <Slider x:Name="SlYaw" Minimum="-180" Maximum="180" ValueChanged="Slider_Changed"/>
                    <DockPanel><TextBlock Text="Tilt (pitch)" Width="100"/><TextBlock x:Name="PitchText" HorizontalAlignment="Right" Foreground="#9FB4D8"/></DockPanel>
                    <Slider x:Name="SlPitch" Minimum="-90" Maximum="90" ValueChanged="Slider_Changed"/>
                    <DockPanel><TextBlock Text="Roll" Width="100"/><TextBlock x:Name="RollText" HorizontalAlignment="Right" Foreground="#9FB4D8"/></DockPanel>
                    <Slider x:Name="SlRoll" Minimum="-180" Maximum="180" ValueChanged="Slider_Changed"/>
                    <DockPanel><TextBlock Text="Zoom" Width="100"/><TextBlock x:Name="ZoomText" HorizontalAlignment="Right" Foreground="#9FB4D8"/></DockPanel>
                    <Slider x:Name="SlZoom" ValueChanged="Slider_Changed"/>

                    <TextBlock Style="{StaticResource Head}" Text="POSITION / VIEWS"/>
                    <TextBlock x:Name="TargetText" Foreground="#9FB4D8" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Content="Reset view" Click="ResetView_Click"/>
                        <Button Content="Centre on Sun" Click="CenterSun_Click"/>
                        <Button Content="Top view" Click="TopView_Click"/>
                        <Button Content="Side view" Click="SideView_Click"/>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Head}" Text="DISPLAY"/>
                    <CheckBox x:Name="ChkGrid" Content="Distance rings (quarter / half / 3-quarter / full range)" IsChecked="True" Click="Options_Changed"/>
                    <CheckBox x:Name="ChkAxes" Content="Coordinate axes" IsChecked="True" Click="Options_Changed"/>
                    <CheckBox x:Name="ChkDrop" Content="Drop lines to equatorial plane" Click="Options_Changed"/>
                    <CheckBox x:Name="ChkHosts" Content="Show only stars with planets" Click="Options_Changed"/>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="Labels" VerticalAlignment="Center" Width="60"/>
                        <ComboBox x:Name="CmbLabels" SelectedIndex="1" Foreground="Black" Focusable="False"
                                  SelectionChanged="Options_Changed">
                            <ComboBoxItem Content="Off"/>
                            <ComboBoxItem Content="Planet hosts"/>
                            <ComboBoxItem Content="All named stars"/>
                        </ComboBox>
                    </DockPanel>

                    <TextBlock Style="{StaticResource Head}" Text="STAR INFO"/>
                    <Border Background="#0A101C" BorderBrush="#25314A" BorderThickness="1" CornerRadius="4" Padding="8" MinHeight="120">
                        <TextBlock x:Name="InfoText" TextWrapping="Wrap" Foreground="#DDE6F5"
                                   Text="Hover over a star, or click one to select it. Double-click a star to centre the view on it."/>
                    </Border>

                    <TextBlock Style="{StaticResource Head}" Text="DATA"/>
                    <Button x:Name="BtnRefresh" Content="Refresh data (re-download)" Click="Refresh_Click"/>
                    <Button Content="Load catalogue CSV..." Click="LoadCsv_Click"/>

                    <TextBlock Style="{StaticResource Head}" Text="CONTROLS"/>
                    <TextBlock Foreground="#8CA0C4" TextWrapping="Wrap" LineHeight="18">
                        <Run Text="Left-drag: rotate"/><LineBreak/>
                        <Run Text="Right-drag / Shift+left-drag: pan"/><LineBreak/>
                        <Run Text="Ctrl+left-drag: roll"/><LineBreak/>
                        <Run Text="Mouse wheel: zoom"/><LineBreak/>
                        <Run Text="Arrow keys: rotate / tilt   Z X: roll"/><LineBreak/>
                        <Run Text="W A S D: pan   Q E: move forward / back"/><LineBreak/>
                        <Run Text="+ / -: zoom     R: reset"/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
